# Settings for the browser interface. Copy to web/.env.local; all are optional.

# Where Jarvis (web.py) listens. A built page (served by Jarvis) uses the address it was loaded
# from; the Vite dev server defaults to ws://localhost:8790. Keep in step with JARVIS_WEB_PORT.
# VITE_BRIDGE_URL=ws://localhost:8790

# Browser text-to-speech engine. Default system.
#   system — the browser's built-in speechSynthesis. Instant, on-device.
#   kokoro — a neural voice running in the browser. Better sound, slower to start.
# VITE_TTS_ENGINE=system

# Which Kokoro voice, when VITE_TTS_ENGINE=kokoro. Default bm_george.
# VITE_KOKORO_VOICE=bm_george
